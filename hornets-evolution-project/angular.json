{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "hornets-evolution-project": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
  "src/styles.css",
  "src/assets/resources/ol.css",
  "src/assets/resources/ol-layerswitcher.css",
  "src/assets/resources/qgis2web.css",
              "src/styles.css"
            ],
            "scripts": [
    "src/assets/resources/ol.js",
    "src/assets/resources/ol-layerswitcher.js",
    "src/assets/resources/Autolinker.min.js",
    "src/assets/resources/qgis2web_expressions.js",
    "src/assets/resources/qgis2web.js",
    "src/assets/resources/functions.js",
    "src/assets/scripts/main.js", 

    "src/assets/layers/FullRoads.js",
    "src/assets/layers/Annexation_History.js",
    "src/assets/styles/Annexation_History_style.js",
    "src/assets/styles/2025MissingRoads_style.js",
    "src/assets/layers/MissingRoads.js",
    "src/assets/styles/FullRoads_style.js",
    "src/assets/layers/Sevensisters.js",
    "src/assets/layers/Pointsofinterest.js",
    "src/assets/styles/Sevensisters_style.js",
    "src/assets/styles/Pointsofinterest_style.js",
    "src/assets/layers/new-layers.js",
    
    "https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js",
    "https://buttons.github.io/buttons.js" 
]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "hornets-evolution-project:build:production"
            },
            "development": {
              "buildTarget": "hornets-evolution-project:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          }
        }
      }
    }
  }
}
